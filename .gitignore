# ==========================================
# GitPulse / OmniPulse Analytics .gitignore
# ==========================================

# Virtual Environments (Python)
venv/
backend/venv/
.venv/
env/
ENV/

# Node & Package Managers
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js Build & Cache
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
backend/.pytest_cache/
.coverage
htmlcov/

# Local Database & Storage State
*.duckdb
*.duckdb.wal
backend/data/*.duckdb
backend/data/*.duckdb.wal
!backend/data/.gitkeep

# Environment Variables & Secrets
.env
backend/.env
frontend/.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Operating System & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
