# OmniPulse Backend Environment Configuration
PROJECT_NAME="OmniPulse Analytics"
VERSION="1.0.0"
ENV="development"

# DuckDB (Columnar embedded time-series storage)
DUCKDB_PATH="data/omnipulse.duckdb"

# Security & HMAC Ingestion
HMAC_SECRET="omnipulse-default-secret-key-change-in-production"
BUFFER_FLUSH_INTERVAL_SECONDS=1.0
BUFFER_BATCH_SIZE=500

# Optional: Google GenAI API Key for dynamic Gemini Text-to-Insight
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
